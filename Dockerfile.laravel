# Stage 1: PHP Environment
FROM php:latest AS php-builder

RUN apt-get update && apt-get install -y \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libxml2-dev \
    libonig-dev \
    libicu-dev \
    libxslt-dev \
    zlib1g-dev \
    libzip-dev \
    unzip \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install pdo pdo_mysql sockets gd calendar intl exif zip

RUN curl -sS https://getcomposer.org/installer | php -- \
     --install-dir=/usr/local/bin --filename=composer

WORKDIR /app

# Copy the entire project first
COPY . .

# Set proper permissions
RUN chown -R www-data:www-data /app \
    && chmod -R 755 /app \
    && chmod -R 777 /app/storage

# Install dependencies as www-data user
USER www-data
RUN composer install --no-dev --optimize-autoloader

# Stage 2: Node.js Environment
FROM node:lts-alpine AS node-builder

WORKDIR /app
COPY package*.json ./
RUN npm install
COPY --from=php-builder /app/vendor ./vendor
COPY . .
RUN npm run build

# Stage 3: Final Production Image
FROM php:latest

RUN apt-get update && apt-get install -y \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libxml2-dev \
    libonig-dev \
    libicu-dev \
    libxslt-dev \
    zlib1g-dev \
    libzip-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install pdo pdo_mysql sockets gd calendar intl exif zip

WORKDIR /app

# Copy results from previous stages
COPY --from=php-builder /app /app
COPY --from=node-builder /app/public ./public

# Set proper permissions
RUN chown -R www-data:www-data /app \
    && chmod -R 755 /app \
    && chmod -R 777 /app/storage

USER www-data

EXPOSE 80
CMD ["php", "-S", "0.0.0.0:80", "-t", "/app/public"]